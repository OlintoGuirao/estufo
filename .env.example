# URL base da API REST (sem barra no final). Vazio = usa dados de exemplo.
VITE_API_URL=
# Força dados de exemplo mesmo com VITE_API_URL definida
VITE_USE_MOCK=false

# Supabase (browser) — Dashboard → Project Settings → API
# Docs: docs/database.md
# Após criar o projeto, rode no SQL Editor as migrations 001→009
# (008 = erros/simulados/Quest; 009 = progresso/anotações/quiz das videoaulas).
VITE_SUPABASE_URL=https://seu-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Videoaulas — Bunny Storage + Pull Zone (recomendado para 2+ usuários externos)
# Estrutura na Storage: pastas por matéria (Portugues/, Excel/, …) com .mp4 dentro.
# No Pull Zone, ative CORS (origem do app) e Range requests.
# BUNNY_STORAGE_ZONE=sua-storage-zone
# BUNNY_STORAGE_ACCESS_KEY=senha-ftp-da-zone
# BUNNY_STORAGE_HOST=storage.bunnycdn.com
# BUNNY_CDN_BASE_URL=https://sua-pullzone.b-cdn.net
# BUNNY_STORAGE_PREFIX=
# Opcional: Token Authentication da Pull Zone (CDN → Security).
# Sem isso, o app faz proxy autenticado pela Storage (evita 401 no player).
# BUNNY_CDN_TOKEN_KEY=
#
# Fallback local (só se Bunny não estiver configurada):
# VIDEO_LESSONS_ROOT=D:\Videos\Dailymotion

# Opcional: Postgres direto só para npm run db:migrate (sem VITE_)
# DATABASE_URL=postgresql://postgres.XXXX:SENHA@aws-0-….pooler.supabase.com:6543/postgres

# Provedor de questões (SOMENTE servidor — NÃO use prefixo VITE_)
# Documentação do contrato: docs/question-provider.md
# QUESTIONS_API_KEY=
# QUESTIONS_API_BASE_URL=
# QUESTIONS_API_PROVIDER_NAME=http-licensed
# QUESTIONS_API_CACHE=off

# Tutor IA (Gemini Flash-Lite) — SOMENTE servidor, sem prefixo VITE_
# Usado em Mapas mentais e no /quest (aula + questões padrão VUNESP A–E).
# Documentação: docs/tutor-ollama.md
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=90000
# GEMINI_USE_MOCK=false
#
# Fallback opcional (só se Gemini não estiver configurado):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_TIMEOUT_MS=60000
# OLLAMA_USE_MOCK=false
#
# Sem chave: o app gera pacote DEMO (mock) claramente identificado — não inventa como se fosse seu material.

# Importação manual de provas (PDF) — SOMENTE servidor
# Documentação: docs/exam-import.md
# EXAM_IMPORT_ADMIN_EMAILS=seu@email.com
# EXAM_IMPORT_STORAGE_DIR=.data/exam-imports
